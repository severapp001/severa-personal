{
  "redirects": [
    {
      "source": "/((?!app/|app$|landing/|splash/|index\\.html|manifest\\.json|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|favicon\\.ico).+)",
      "destination": "/app/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/app/assets/node_modules/:path*", "destination": "/app/assets/vendor/:path*" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" }
  ],
  "headers": [
    {
      "source": "/app/_expo/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/app/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
