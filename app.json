{
  "expo": {
    "name": "Severa",
    "slug": "severa-personal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "severa",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "cl.severa.personal",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cl.severa.personal",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#D4AF5A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0B0C",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdd196e7-68f0-453c-a496-c878053349dd"
      }
    },
    "owner": "severa001",
    "updates": {
      "url": "https://u.expo.dev/cdd196e7-68f0-453c-a496-c878053349dd"
    }
  }
}
